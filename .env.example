# PostgreSQL connection. For Docker Compose this is supplied by compose.yaml.
DATABASE_URL=
POSTGRES_PASSWORD=replace_with_local_password
PORT=3001
# Optional for career ranking; required for real AI summaries of chats.
# Keep this value only in local .env or a deployment secret store.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# For npm run dev, Vite runs on :5173 and proxies /api to :3001.
APP_ORIGIN=http://localhost:5173
