# PostgreSQL connection. For Docker Compose this is supplied by compose.yaml.
DATABASE_URL=
POSTGRES_PASSWORD=replace_with_local_password
PORT=3001
# Optional: enables OpenAI ranking and natural-language explanations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HR_ACCESS_CODE=replace_with_private_hr_code
# Demo only: employee profiles are selectable without authentication.
